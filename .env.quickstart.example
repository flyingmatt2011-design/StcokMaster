# StockMaster 最小启动配置
# 完整配置仍以 .env.example 和设置页配置注册表为准。
# 复制为 .env 后填写密钥；未配置的可选能力会按原项目策略降级。

# 至少填写一只股票；多个代码用英文逗号分隔。
STOCK_LIST=600519

# 股票报告沿用默认 LiteLLM 分析链路。
GENERATION_BACKEND=litellm

# 填写一个可用模型密钥；也可在 StockMaster 设置页配置其他渠道。
DEEPSEEK_API_KEY=

# 可选；留空时继续使用现有免费数据源 fallback。
TUSHARE_TOKEN=

# 可选；中文 A 股新闻搜索首选渠道。
BOCHA_API_KEYS=

# 可选；新闻搜索备用渠道。
TAVILY_API_KEYS=

# 报告语言。
REPORT_LANGUAGE=zh

# warn 保持兼容；strict 遇到 error 级配置问题时停止启动。
CONFIG_VALIDATE_MODE=warn
