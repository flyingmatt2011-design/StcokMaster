{
  "name": "stockmaster-desktop",
  "version": "3.21.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.stockmaster.desktop",
    "productName": "StockMaster",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/afterPackMacos.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "algorithm-update/**/*"
    ],
    "extraResources": [
      {
        "from": "../../.env.example",
        "to": ".env.example"
      },
      {
        "from": "../../dist/backend/stock_analysis",
        "to": "backend/stock_analysis"
      },
      {
        "from": "../../stockmaster/algorithm-update-policy.json",
        "to": "stockmaster/algorithm-update-policy.json"
      },
      {
        "from": "../../stockmaster/upstream-baseline.json",
        "to": "stockmaster/upstream-baseline.json"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "StockMaster-${version}-${arch}.${ext}",
      "publish": [
        {
          "provider": "github",
          "owner": "ZhuLinsen",
          "repo": "daily_stock_analysis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "include": "installer.nsh"
    },
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "target": "dmg"
    }
  }
}
